<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.maven</groupId>
    <artifactId>template</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <out.dir>${project.basedir}/out</out.dir>
    </properties>

    <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>javasnes</id>
            <url>https://brunorns.github.io/javasnes/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>javasnes</groupId>
            <artifactId>framework</artifactId>
            <version>[1.0-rolling-,)</version>
        </dependency>
        <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <version>3.0.18</version>
            <type>pom</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>2.1.0</version>
                <executions>
                    <execution>
                        <id>build-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    def srcDir = new File("src/main/java")
                                    def outDir = new File("out")
                                    def classesDir = new File("target/classes")
                                    
                                    println "Searching for classes with main method..."
                                    
                                    srcDir.eachFileRecurse { file ->
                                        if (file.name.endsWith('.java') && file.text.contains('public static void main(String[] args)')) {
                                            def className = file.name - '.java'
                                            def outputDir = new File("out/" + className)
                                            outputDir.mkdirs()
                                            
                                            println "Creating JAR for: " + className
                                            
                                            def jarCommand = [
                                                "jar", "cfe", 
                                                "out/" + className + "/" + className + ".jar",
                                                className,
                                                "-C", "target/classes", "."
                                            ]
                                            
                                            def process = jarCommand.execute(null, new File("."))
                                            process.waitFor()
                                            
                                            if (process.exitValue() == 0) {
                                                println className + ".jar created in out/" + className + "/"
                                            } else {
                                                println "Error generating JAR for class: " + className
                                            }
                                        }
                                    }
                                    
                                    println "JAR successfully generated in: out/"
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>out</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>